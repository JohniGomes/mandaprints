# URL pública do site (usada nos back_urls e no webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — mercadopago.com.br/developers/panel
# Comece com as credenciais de TESTE, troque para produção antes do lançamento.
MERCADOPAGO_ACCESS_TOKEN=

# Melhor Envio — melhorenvio.com.br > Configurações > Tokens de Integração
MELHOR_ENVIO_TOKEN=
# CEP de onde o FORNECEDOR despacha os produtos (não o CEP do Filipe)
MELHOR_ENVIO_CEP_ORIGEM=

# Resend — resend.com (envio de e-mails transacionais)
RESEND_API_KEY=

# E-mails que recebem o aviso automático de cada venda aprovada
EMAIL_LOJA=contato@filipelarafotografia.com.br
EMAIL_FORNECEDOR=
